# custom aliases sourced by ~/.zshrc

# aliases for directory listings
alias ls='ls -l -F --color'
alias dir='dir -F --color'
alias ll='ls -al -F --color'

#foo
#alias man='LANG=C man'

# only nonroot need these aliases
if [[ EUID != 0 ]]; then
  # alias for ifconfig, as /sbin is not in $path
  [[ -e /sbin/ifconfig ]] && alias ifconfig='/sbin/ifconfig'
  # same for ip and ss
  [[ -e /sbin/ip ]] && alias ip='/sbin/ip'
  [[ -e /sbin/ss ]] && alias ss='/sbin/ss'

  # glob aliases; imho too dangerous to use as root.
  alias -g T="tail -n 25"
  alias -g L="less"
fi

# make dirchanges easy ( taken from strcat ;> )
# WARNING: This only works with autocd set!
alias ...='../..'
alias ....='../../..'
alias .....='../../../..'

# fzf search with autopushd
alias cdf='cd $(dirs -lp | fzf)'

# suffix aliases (requires zsh >= 4.2.0) so watch out
# some file suffixes
alias -s {c,cpp,h,hpp}=${EDITOR:-vi}		# c/cpp files
alias -s {txt,conf}=${EDITOR:-vi}		# txt and configuration stuff
alias -s {jpg,png,gif}=fbi			# Imageviewer
alias -s pdf=fbgs				# PDF to image converter for fbi

alias grep='grep --color=always'

# simple webserver
alias httpd="python3 -m http.server"

# claude
alias claude='podman run --rm -ti --security-opt label=disable --volume "${HOME}/.config/gcloud:/root/.config/gcloud" --volume "$(pwd):/app" --env-file ~/Devel/claude-container/claude.env claude claude'

# yt-dlp
alias yt-dlp-all="yt-dlp --sub-langs all --embed-subs --audio-multistreams --prefer-free-formats --format 'bv*+mergeall[vcodec=none]'"
alias yt-dlp-playlist="yt-dlp --preset-alias mp3 --output '%(playlist_index)s-%(title)s.%(ext)s'"

# prefer vim, even when I am lazy
if [[ -x /usr/bin/nvim ]]; then
  alias vim=nvim
  export EDITOR=nvim
fi
alias vi=vim
